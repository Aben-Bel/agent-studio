# Copy to .env and fill in:  cp .env.example .env
# .env is gitignored — never commit real credentials.

# ---- AWS credentials (CLI / programmatic access) ----
# From: IAM user access key, or the console "Command line access" block.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Uncomment ONLY for temporary credentials (keys starting with ASIA...).
# Leave commented for long-lived IAM keys (AKIA...) — an empty value breaks auth.
# AWS_SESSION_TOKEN=

# Region must have Bedrock + the model enabled. us-west-2 supports Amazon Nova.
AWS_REGION=us-west-2

# ---- App / LLM ----
# 0 = call real Bedrock (needs the creds above). 1 = offline mock, no AWS calls.
MOCK_LLM=0
MODEL_ID=amazon.nova-micro-v1:0
MAX_STEPS=8
